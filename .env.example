# Copy to .env.local and fill in. Never commit real values.
# Production and Preview values live in Vercel. Full list: docs/2026-revamp-specs/2026-revamp-plan.md §7

# --- Site -------------------------------------------------------------------
# Canonical URL for metadata, the feed and the sitemap. Defaults to https://francisaguilar.co (Phase 4)
NEXT_PUBLIC_SITE_URL=

# --- PostHog (analytics, feature flags, maintenance mode) -------------------
# Project API key
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=
# Only for server-side flag evaluation (Phase 7)
POSTHOG_PERSONAL_API_KEY=

# --- Maintenance mode (switch: PostHog flag `is_maintenance_mode`) ----------
# Optional override that wins over PostHog: on | off (needs a redeploy)
MAINTENANCE_MODE=
# Long random string (openssl rand -hex 24). Visit /?preview=<token> to see the real site
# while maintenance is on (sets a 7-day cookie).
MAINTENANCE_BYPASS_TOKEN=
# Comma-separated path prefixes that stay public during maintenance, e.g. /writings,/rss.xml
MAINTENANCE_ALLOWED_PATHS=

# --- Strava (Phase 7) -------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# --- Spotify (Phase 7) ------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- GitHub (Phase 7) -------------------------------------------------------
# Fine-grained token, public repositories, read-only
GITHUB_TOKEN=

# --- Contact form (Phase 7) -------------------------------------------------
RESEND_API_KEY=
# Where messages are delivered
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Booking (Phase 5) ------------------------------------------------------
# Google Calendar appointment schedule URL
NEXT_PUBLIC_BOOKING_URL=
