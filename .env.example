# PostHog (analytics + feature flags)
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=

# Maintenance mode: controlled by the PostHog flag `is_maintenance_mode`
# Optional override when PostHog is unreachable: on | off
MAINTENANCE_MODE=
# Visit /?preview=<token> to see the real site while maintenance is on (sets a 7-day cookie)
MAINTENANCE_BYPASS_TOKEN=
# Comma-separated path prefixes that stay reachable during maintenance, e.g. /blog,/rss.xml
MAINTENANCE_ALLOWED_PATHS=
